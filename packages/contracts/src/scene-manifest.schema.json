{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-roblox-obby-builder.local/schemas/scene-manifest.schema.json",
  "title": "SceneManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sceneId", "spawn", "parts"],
  "properties": {
    "version": {"const": "0.1"},
    "sceneId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "spawn": {"$ref": "#/$defs/transform"},
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "shape", "transform", "size", "color", "material", "collision"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "role": {"enum": ["platform", "checkpoint", "kill", "decoration", "finish"]},
          "shape": {"enum": ["Block", "Ball", "Cylinder", "Wedge"]},
          "transform": {"$ref": "#/$defs/transform"},
          "size": {"$ref": "#/$defs/vector3Positive"},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "material": {"enum": ["SmoothPlastic", "Plastic", "Metal", "Neon", "Concrete", "Wood"]},
          "collision": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "vector3": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}},
    "vector3Positive": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": "number", "exclusiveMinimum": 0}, "y": {"type": "number", "exclusiveMinimum": 0}, "z": {"type": "number", "exclusiveMinimum": 0}}},
    "transform": {"type": "object", "additionalProperties": false, "required": ["position", "rotation"], "properties": {"position": {"$ref": "#/$defs/vector3"}, "rotation": {"$ref": "#/$defs/vector3"}}}
  }
}
