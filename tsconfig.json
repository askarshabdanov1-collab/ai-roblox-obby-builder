{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@obby/canonical-json": ["./packages/canonical-json/src/index.ts"],
      "@obby/contracts": ["./packages/contracts/src/index.ts"],
      "@obby/geometry-evaluator": [
        "./packages/geometry-evaluator/src/index.ts"
      ],
      "@obby/obby-compiler": ["./packages/obby-compiler/src/index.ts"],
      "@obby/obby-evaluator-contracts": [
        "./packages/obby-evaluator-contracts/src/index.ts"
      ],
      "@obby/route-playability-evaluator": [
        "./packages/route-playability-evaluator/src/index.ts"
      ],
      "@obby/roblox-emitter": ["./packages/roblox-emitter/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts"
  ]
}
